  },
  "nodes": [
    {
      "id": "node_001",
      "label": "バリューチェーン起点設計",
      "object_type": "concept",
      "description": "製品や認証機能の都合ではなく、企業間の役割分担、責任境界、接続頻度、停止許容度が ID 管理設計を規定するという考え方。",
      "properties": {
        "design_question": [
          "誰が主体か",
          "人間か機械か",
          "どの業務段階か",
          "接続停止の業務影響は何か"
        ]
      }
    },
    {
      "id": "node_002",
      "label": "製造業バリューチェーン",
      "object_type": "pattern",
      "description": "調達から設計、製造、物流、販売、保守まで多数の委託先と長期接続を持つ日本型製造業の外部連携構造。",
      "properties": {
        "industries": [
          "重工",
          "化学",
          "自動車",
          "電機"
        ],
        "identity_pressure": "委託先と設備ベンダーが混在し、人間 ID と機械 ID の両方が長期残存しやすい。"
      }
    },
    {
      "id": "node_003",
      "label": "金融業バリューチェーン",
      "object_type": "pattern",
      "description": "市場インフラ、専用回線、規制報告、外部販売網を前提に、接続停止が制度対応や決済継続性へ直結する構造。",
      "properties": {
        "industries": [
          "銀行",
          "証券",
          "保険"
        ],
        "identity_pressure": "閉域接続の運用統制と外部人材ポータルの統制を同時に求められる。"
      }
    },
    {
      "id": "node_004",
      "label": "エネルギーバリューチェーン",
      "object_type": "pattern",
      "description": "設備保守、系統連携、取引市場、メーター通信、顧客ポータルが併存し、IT と OT の責任分界が難しい構造。",
      "properties": {
        "industries": [
          "電力",
          "ガス",
          "石油"
        ],
        "identity_pressure": "OT 側のベンダーアクセスと顧客向け認証の要求水準が大きく異なる。"
      }
    },
    {
      "id": "node_005",
      "label": "流通・小売バリューチェーン",
      "object_type": "pattern",
      "description": "仕入、物流、販売、会員サービスの多段接続があり、旧来 EDI とモダン API が同居しやすい構造。",
      "properties": {
        "industries": [
          "総合小売",
          "専門店",
          "流通"
        ],
        "identity_pressure": "旧来接続を止めずに顧客接点だけモダン化する設計が求められる。"
      }
    },
    {
      "id": "node_006",
      "label": "EDI型",
      "object_type": "pattern",
      "description": "人間の対話ログインを前提とせず、定型データを企業間で交換する機械間接続パターン。",
      "properties": {
        "human_involvement": "none",
        "typical_authentication": [
          "証明書ベース認証",
          "固定 IP 許可"
        ],
        "transport_examples": [
          "AS2",
          "SFTP",
          "全銀 EDI"
        ]
      }
    },
    {
      "id": "node_007",
      "label": "ポータル型",
      "object_type": "pattern",
      "description": "取引先担当者や委託先要員がブラウザ経由で業務ポータルにアクセスする外部人間向け接続パターン。",
      "properties": {
        "human_involvement": "high",
        "typical_authentication": [
          "多要素認証",
          "条件付きアクセス"
        ],
        "lifecycle_focus": [
          "入社",
          "異動",
          "退職",
          "契約終了"
        ]
      }
    },
    {
      "id": "node_008",
      "label": "APIゲートウェイ型",
      "object_type": "pattern",
      "description": "アプリケーション同士がリアルタイム API で接続し、権限範囲と秘密情報管理が設計の中心となる接続パターン。",
      "properties": {
        "human_involvement": "low",
        "typical_authentication": [
          "OAuth 2.0",
          "サービスアカウント"
        ],
        "control_focus": [
          "スコープ設計",
          "秘密情報ローテーション",
          "送信元制御"
        ]
      }
    },
    {
      "id": "node_009",
      "label": "フェデレーション型",
      "object_type": "pattern",
      "description": "別組織の ID を相互信頼し、SAML や OpenID Connect によるシングルサインオンを実現する接続パターン。",
      "properties": {
        "human_involvement": "high",
        "typical_authentication": [
          "フェデレーション認証",
          "SAML",
          "OpenID Connect"
        ],
        "governance_focus": [
          "信頼関係の棚卸し",
          "相手先統制評価"
        ]
      }
    },
    {
      "id": "node_010",
      "label": "専用回線型",
      "object_type": "pattern",
      "description": "閉域網や専用線の業界インフラ上で接続し、端末統制とオペレーター統制を重視する接続パターン。",
      "properties": {
        "human_involvement": "mixed",
        "typical_authentication": [
          "固定 IP 許可",
          "特権アクセス管理"
        ],
        "control_focus": [
          "接続端末管理",
          "運用者分離",
          "監査証跡"
        ]
      }
    },
    {
      "id": "node_011",
      "label": "証明書ベース認証",
      "object_type": "pattern",
      "description": "企業間接続でクライアント証明書や相互 TLS を用いて相手システムを識別する方式。",
      "properties": {
        "identity_subject": "machine",
        "renewal_risk": "証明書更改忘れが停止要因になる"
      }
    },
    {
      "id": "node_012",
      "label": "固定 IP 許可",
      "object_type": "pattern",
      "description": "送信元 IP や回線セグメントを条件に接続を許可する旧来から多い境界型制御。",
      "properties": {
        "identity_subject": "network-origin",
        "operational_caution": "回線更改や冗長化時に申請漏れが起きやすい"
      }
    },
    {
      "id": "node_013",
      "label": "多要素認証",
      "object_type": "concept",
      "description": "外部人間向け接続で必須化しやすい基本統制。単一パスワード依存を減らす。",
      "properties": {
        "identity_subject": "human",
        "priority": "high"
      }
    },
    {
      "id": "node_014",
      "label": "OAuth 2.0",
      "object_type": "protocol",
      "description": "API アクセス委任の標準であり、アプリ間連携のスコープ設計とトークン管理の中核となる。",
      "properties": {
        "identity_subject": "application",
        "primary_use_case": "API access delegation"
      }
    },
    {
      "id": "node_015",
      "label": "OpenID Connect",
      "object_type": "protocol",
      "description": "外部ポータルやパートナー向け Web 認証で利用しやすいモダンな認証連携方式。",
      "properties": {
        "identity_subject": "human-and-application",
        "primary_use_case": "modern web federation"
      }
    },
    {
      "id": "node_016",
      "label": "SAML",
      "object_type": "protocol",
      "description": "企業間ポータルのシングルサインオンで広く使われる XML ベースの認証連携方式。",
      "properties": {
        "identity_subject": "human",
        "primary_use_case": "enterprise federation"
      }
    },
    {
      "id": "node_017",
      "label": "フェデレーション認証",
      "object_type": "concept",
      "description": "相手組織の本人確認結果を自社が受け入れる認証モデルで、契約と運用統制が前提となる。",
      "properties": {
        "dependency": "counterparty identity governance",
        "review_cycle": "minimum annual"
      }
    },
    {
      "id": "node_018",
      "label": "特権アクセス管理",
      "object_type": "concept",
      "description": "外部保守、閉域接続、運用端末に関わる高権限操作を制御し、記録、承認、時間制限を加える統制。",
      "properties": {
        "focus": [
          "承認",
          "録画",
          "時間制限",
          "資格情報分離"
        ]
      }
    },
    {
      "id": "node_019",
      "label": "踏み台サーバー",
      "object_type": "product",
      "description": "ベンダー保守や外部委託要員が直接対象環境へ入らず、中継点で接続制御と監査を受けるための運用基盤。",
      "properties": {
        "control_role": "session brokering",
        "typical_zone": "DMZ or dedicated admin segment"
      }
    },
    {
      "id": "node_020",
      "label": "条件付きアクセス",
      "object_type": "concept",
      "description": "場所、端末状態、リスク、接続元属性に応じて外部ポータルや API 利用条件を変える制御。",
      "properties": {
        "control_dimensions": [
          "location",
          "device state",
          "risk",
          "session"
        ]
      }
    },
    {
      "id": "node_021",
      "label": "サービスアカウント",
      "object_type": "concept",
      "description": "人間ではなくシステムやジョブが利用する ID。外部 API や連携ジョブで棚卸しとローテーションが重要になる。",
      "properties": {
        "identity_subject": "workload",
        "governance_focus": [
          "owner",
          "rotation",
          "scope"
        ]
      }
    },
    {
      "id": "node_022",
      "label": "証明書期限切れ",
      "object_type": "risk",
      "description": "機械間接続で証明書の失効や有効期限切れに気付かず、業務停止を招くリスク。",
      "properties": {
        "impact": "EDI 停止、物流停止、報告遅延"
      }
    },
    {
      "id": "node_023",
      "label": "固定 IP 変更連絡漏れ",
      "object_type": "risk",
      "description": "回線更改や DR 切り替え時に接続元更新が反映されず、疎通停止や暫定穴あけを招くリスク。",
      "properties": {
        "impact": "可用性低下と例外運用増加"
      }
    },
    {
      "id": "node_024",
      "label": "担当者アカウント残存",
      "object_type": "risk",
      "description": "取引先担当者の異動、退職、契約終了後も外部ポータル ID が削除されないリスク。",
      "properties": {
        "impact": "不正閲覧、退職者アクセス、監査指摘"
      }
    },
    {
      "id": "node_025",
      "label": "多要素認証未適用",
      "object_type": "risk",
      "description": "外部人間向けポータルで単一要素認証のままとなり、パスワード窃取で侵害されやすいリスク。",
      "properties": {
        "impact": "なりすまし、情報漏えい"
      }
    },
    {
      "id": "node_026",
      "label": "API キー漏洩",
      "object_type": "risk",
      "description": "アプリ間連携で長寿命の秘密情報がコード、端末、委託先環境から流出するリスク。",
      "properties": {
        "impact": "大量データ取得、不正送信"
      }
    },
    {
      "id": "node_027",
      "label": "スコープ過剰付与",
      "object_type": "risk",
      "description": "OAuth 2.0 やサービスアカウントに必要以上の権限を持たせ、侵害時の影響を拡大するリスク。",
      "properties": {
        "impact": "過剰参照、過剰更新、横展開"
      }
    },
    {
      "id": "node_028",
      "label": "信頼関係棚卸し不足",
      "object_type": "risk",
      "description": "フェデレーション先や委託先との信頼設定が残存し、実態と合わないアクセスが継続するリスク。",
      "properties": {
        "impact": "不要な SSO、監査不能"
      }
    },
    {
      "id": "node_029",
      "label": "接続端末特権濫用",
      "object_type": "risk",
      "description": "専用回線端末や保守端末が共有運用となり、実行者追跡や責任分離が失われるリスク。",
      "properties": {
        "impact": "不正操作、追跡不能"
      }
    },
    {
      "id": "node_030",
      "label": "委託先 VPN 経由侵入",
      "object_type": "risk",
      "description": "委託先や保守ベンダーの接続経路が侵害され、自社環境へ横展開されるリスク。",
      "properties": {
        "attack_reference": "Kaseya 型",
        "impact": "管理経路の信頼失墜"
      }
    },
    {
      "id": "node_031",
      "label": "BEC 型 ID 偽装",
      "object_type": "risk",
      "description": "取引先メールアカウントが侵害され、正規担当者を装って ID 作成や支払先変更を誘導するリスク。",
      "properties": {
        "attack_reference": "Business Email Compromise",
        "impact": "不正口座変更、なりすまし承認"
      }
    },
    {
      "id": "node_032",
      "label": "信頼済み送信元悪用",
      "object_type": "risk",
      "description": "固定 IP や許可済み送信元を前提にした境界制御が悪用され、正規接続元に見える侵入を許すリスク。",
      "properties": {
        "impact": "境界防御の過信"
      }
    },
    {
      "id": "node_033",
      "label": "ソフトウェアサプライチェーン侵害",
      "object_type": "risk",
      "description": "接続ソフトウェアや更新経路を経由して侵害が連鎖し、信頼済み連携が攻撃面へ転化するリスク。",
      "properties": {
        "attack_reference": "SolarWinds 型",
        "impact": "広域侵害、長期潜伏"
      }
    },
    {
      "id": "node_034",
      "label": "製造業 調達",
      "object_type": "concept",
      "description": "原材料サプライヤーとの発注、納入、請求、購買ポータル接続を扱う段階。",
      "properties": {
        "external_counterpart": "supplier",
        "primary_identity_subject": [
          "machine",
          "human"
        ]
      }
    },
    {
      "id": "node_035",
      "label": "製造業 設計・開発",
      "object_type": "concept",
      "description": "外部設計委託先と図面、仕様、部品表を共有する段階。",
      "properties": {
        "external_counterpart": "design partner",
        "primary_identity_subject": [
          "human"
        ]
      }
    },
    {
      "id": "node_036",
      "label": "製造業 製造",
      "object_type": "concept",
      "description": "設備ベンダー保守や工場システム接続が発生し、OT 越境アクセスを伴う段階。",
      "properties": {
        "external_counterpart": "equipment vendor",
