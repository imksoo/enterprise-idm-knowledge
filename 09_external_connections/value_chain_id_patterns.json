  "knowledge": [
    {
      "id": "knowledge_001",
      "topic": "設計原則",
      "summary": "外部接続の ID 設計は、認証製品の機能差ではなく、どの業務段階で誰が何の責任で接続するかから逆算すべきである。",
      "details": [
        "同じ製造業でも調達は EDI 型、設計はフェデレーション型、保守は特権アクセス管理が中心になる。",
        "単一の認証基盤を押し当てると、業務停止リスクか統制不足のどちらかが残る。"
      ],
      "related_nodes": [
        "node_001",
        "node_006",
        "node_007",
        "node_008",
        "node_009",
        "node_010"
      ]
    },
    {
      "id": "knowledge_002",
      "topic": "製造業 調達",
      "summary": "製造業の調達は、機械間 EDI と担当者向け購買ポータルが同居しやすく、機械 ID と人間 ID を分けて管理する必要がある。",
      "details": [
        "発注や納入実績は EDI 型で継続運用されやすい。",
        "価格確認や例外処理はポータル型で残りやすい。"
      ],
      "related_nodes": [
        "node_034",
        "node_006",
        "node_007"
      ]
    },
    {
      "id": "knowledge_003",
      "topic": "製造業 設計・開発",
      "summary": "外部設計委託先との図面共有は、単純なファイル共有ではなく、契約単位のアクセス境界と SSO 終了条件を設計論点にするべきである。",
      "details": [
        "案件終了後の権限剥奪が遅れると、設計資産が長期間参照可能になる。",
        "フェデレーション型を採る場合も信頼先の棚卸しを前提とする。"
      ],
      "related_nodes": [
        "node_035",
        "node_009",
        "node_028"
      ]
    },
    {
      "id": "knowledge_004",
      "topic": "製造業 製造",
      "summary": "設備ベンダー保守は、ID 連携よりも接続経路とセッション統制が優先されるため、踏み台サーバーと特権アクセス管理が中心になる。",
      "details": [
        "OT 側では相手先 IdP よりも実行者追跡と時間制限が重要である。",
        "委託先 VPN をそのまま信頼しない設計が必要になる。"
      ],
      "related_nodes": [
        "node_036",
        "node_018",
        "node_019",
        "node_030"
      ]
    },
    {
      "id": "knowledge_005",
      "topic": "製造業 物流",
      "summary": "物流連携は停止許容度が低く、固定 IP と証明書に依存した機械間接続が多いため、更改管理の失敗が直接業務停止につながる。",
      "details": [
        "3PL 連携は例外的な手作業回避より接続継続性が優先されやすい。",
        "証明書更新や回線更改の計画通知を ID 運用に組み込む必要がある。"
      ],
      "related_nodes": [
        "node_037",
        "node_011",
        "node_012",
        "node_022",
        "node_023"
      ]
    },
    {
      "id": "knowledge_006",
      "topic": "製造業 販売",
      "summary": "販売代理店ポータルは社外担当者の異動頻度が高く、取引先企業単位ではなく担当者単位のライフサイクル管理を要する。",
      "details": [
        "代理店責任者申請だけに依存すると削除漏れが蓄積する。",
        "多要素認証と条件付きアクセスを最低限の共通統制にするべきである。"
      ],
      "related_nodes": [
        "node_038",
        "node_013",
        "node_020",
        "node_024"
      ]
    },
    {
      "id": "knowledge_007",
      "topic": "製造業 アフターサービス",
      "summary": "社外フィールドエンジニアの現場アクセスは、本人確認だけでなく、現場、機器、期間を限定した権限設計が必要である。",
      "details": [
        "常設アカウントより案件単位の一時権限が適する。",
        "保守完了後のセッション証跡が重要になる。"
      ],
      "related_nodes": [
        "node_039",
        "node_018",
        "node_019"
      ]
    },
    {
      "id": "knowledge_008",
      "topic": "金融業 資金調達",
      "summary": "金融インフラ接続は閉域性だけで十分ではなく、オペレーターの権限分離と接続端末統制が中心論点になる。",
      "details": [
        "専用回線型はネットワーク信頼を前提にしやすいため、端末共有運用が残りやすい。",
